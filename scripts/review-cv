#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/review-cv "Candidate Name" /path/to/cv.pdf --roles "Role A, Role B" [--projects /path/to/projects-list.md] [--date YYYY-MM-DD]

Example:
  scripts/review-cv "Budi Santoso" ~/Downloads/CV_Budi.pdf --roles "Data Analyst, Application Support" --projects ~/Downloads/projects-list.md

This initializes:
  output/candidates/<candidate-slug>/<run-id>/

Then paste the printed prompt back to Codex/agent to run the full cv-brainstormer workflow.
USAGE
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

file_slugify() {
  slugify "$1" | tr '-' '_'
}

candidate_name=""
cv_file=""
roles=""
projects_file=""
run_date="$(date +%F)"

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  usage
  exit 0
fi

if [[ $# -lt 2 ]]; then
  usage
  exit 2
fi

candidate_name="$1"
cv_file="$2"
shift 2

while [[ $# -gt 0 ]]; do
  case "$1" in
    --roles)
      roles="${2:-}"
      shift 2
      ;;
    --projects)
      projects_file="${2:-}"
      shift 2
      ;;
    --date)
      run_date="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$roles" ]]; then
  echo "--roles is required" >&2
  exit 2
fi

if [[ ! -f "$cv_file" ]]; then
  echo "CV file not found: $cv_file" >&2
  exit 1
fi

if [[ -n "$projects_file" && ! -f "$projects_file" ]]; then
  echo "projects file not found: $projects_file" >&2
  exit 1
fi

candidate_slug="$(slugify "$candidate_name")"
candidate_file_slug="$(file_slugify "$candidate_name")"
target_slug="$(slugify "$roles")"
run_id="${run_date}-${target_slug}"
run_dir="output/candidates/${candidate_slug}/${run_id}"

mkdir -p "${run_dir}/input" "${run_dir}/scratch" "${run_dir}/reports" "${run_dir}/salary" "${run_dir}/cv" "${run_dir}/portfolio" "${run_dir}/interview" "${run_dir}/application" "${run_dir}/platform"

cv_ext="${cv_file##*.}"
cp "$cv_file" "${run_dir}/input/original-cv.${cv_ext}"

if [[ -n "$projects_file" ]]; then
  cp "$projects_file" "${run_dir}/input/projects-list.md"
fi

cat > "${run_dir}/input/target-brief.md" <<EOF_BRIEF
# Target Brief

Candidate: ${candidate_name}

Run ID: \`${run_id}\`

Target roles:

$(printf '%s' "$roles" | tr ',' '\n' | sed -E 's/^ */- /; s/ *$//')

Output strategy:

- Use the full cv-brainstormer workflow.
- Create role-specific CV variants.
- Create English and Indonesian CV variants unless the target decision gate says otherwise.
- Name CV files as \`cv-${candidate_file_slug}-<target-role>-en.md\` and \`cv-${candidate_file_slug}-<target-role>-id.md\`.
- Research current salary benchmarks in \`salary/<target-role>/\`.
- Prepare STAR interview stories in \`interview/<target-role>/\`.
- Create cover letter and email outreach in \`application/<target-role>/\`.
- Create platform-specific packages in \`platform/<target-role>/\` (Upwork, LinkedIn, Glints).
- Keep all outputs inside this run folder.

Run folder:

\`${run_dir}\`
EOF_BRIEF

cat > "${run_dir}/input/harvard-resume-checklist.md" <<'EOF_HARVARD'
# Harvard-Inspired Resume Checklist

Use this checklist during CV analysis, synthesis, role tailoring, and final verification.

## Quality Principles

- Tailor the CV to the target role and employer-valued skills.
- Use specific, active, factual language.
- Quantify or qualify claims where evidence supports it.
- Write for people and systems that scan quickly.
- Keep formatting consistent, clean, reverse chronological, and PDF-safe.
- Use recognizable section headers such as Experience, Education, Skills, Projects, and Certifications.
- Avoid personal pronouns, narrative style, slang, flowery language, photos, age, gender, and references.
- Treat AI as an editing aid only; the final CV must stay authentic and interview-defensible.

## Light Gate Labels

- Pass: no major issue remains.
- Minor Issues: usable, but polish remains.
- Needs Revision: not ready to call ready-to-send because major issues remain.

## Required Final Verification

Agent 09 must include a Harvard Resume Standard Check with one of:

- Pass
- Minor Issues
- Needs Revision
EOF_HARVARD

cat > "output/candidates/${candidate_slug}/LATEST.md" <<EOF_LATEST
# Latest Run

Current latest run:

\`${run_id}\`

Run folder:

\`${run_dir}\`
EOF_LATEST

cat <<EOF_DONE
Initialized CV review run:
  ${run_dir}

Input files:
  ${run_dir}/input/original-cv.${cv_ext}
  ${run_dir}/input/target-brief.md
  ${run_dir}/input/harvard-resume-checklist.md
EOF_DONE

if [[ -n "$projects_file" ]]; then
  echo "  ${run_dir}/input/projects-list.md"
fi

cat <<EOF_PROMPT

Paste this prompt to start the agent workflow:

Gunakan skill cv-brainstormer untuk review CV kandidat:
${run_dir}/input/original-cv.${cv_ext}

Target brief:
${run_dir}/input/target-brief.md

Harvard resume checklist:
${run_dir}/input/harvard-resume-checklist.md

CV filename convention:
cv-${candidate_file_slug}-<target-role>-en.md
cv-${candidate_file_slug}-<target-role>-id.md
EOF_PROMPT

if [[ -n "$projects_file" ]]; then
  echo "Project list:"
  echo "${run_dir}/input/projects-list.md"
fi

cat <<EOF_PROMPT_END

Ikuti workflow lengkap:
Agent 00 Extractor, Agent 00.25 Role Discovery Interviewer, Agent 00.5 Target Decision Gate, Agents 01-06, Agent 04.5 Evidence Gate, Agent 05.5 Adjacent Role Strategist, Agent 05.75 Salary Market Analyst, Agent 07 Synthesizer, Agent 08 Role Tailor, Agent 08.5 Portfolio Mapper, Agent 09 Final Verifier, Agent 10 STAR Interview Coach, dan Agent 11 Application Package Writer.

Gunakan Harvard resume checklist untuk memastikan CV tailored, spesifik, aktif, faktual, mudah discan, formatnya aman ATS, dan tidak overclaim. Agent 09 wajib menyertakan Harvard Resume Standard Check dengan status Pass, Minor Issues, atau Needs Revision.

Pastikan struktur output per target role tersimpan lengkap di subfolder:
- salary/<target-role>/salary-market-<target-role>.*
- cv/<target-role>/cv-${candidate_file_slug}-<target-role>-en.* dan *-id.*
- portfolio/projects-from-list.*
- interview/<target-role>/star-<target-role>-en.* dan *-id.*
- application/<target-role>/cover-letter-*, email-application-*, email-follow-up-*
- platform/<target-role>/upwork.md, linkedin.md, glints.md

Output wajib masuk ke:
${run_dir}
EOF_PROMPT_END
